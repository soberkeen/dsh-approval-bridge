{
  "name": "@dsh-external/dsh-agent-hud",
  "version": "0.2.0",
  "description": "DSH 通知桥：权限确认（approval/request）双通道并行先到先得；DSH 提问（user-questions/request）与任务回合完成（agent/turn-stopping）以 HUD notify 气泡纯提醒。含设置分区与决策日志。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "agent-hud",
    "notification"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-locale": "*"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/hud.js && node --check lib/settings.js && node --check lib/server.js && node --check lib/client.js",
    "test": "node scripts/client-register-test.mjs"
  }
}
